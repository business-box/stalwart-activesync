# Copy to .env and edit. Everything here has a working default for a laptop
# except the three secrets at the top.

# --- Secrets ---------------------------------------------------------------
# Stalwart's recovery admin (user "admin"); remove once a real admin exists.
STALWART_ADMIN_PASSWORD=change-me-now
# Bearer token for the gateway's /admin API (127.0.0.1:8081).
EAS_ADMIN_TOKEN=change-me-too
# Bulwark "remember me" and settings encryption: openssl rand -base64 32
BULWARK_SESSION_SECRET=

# --- Names and TLS ---------------------------------------------------------
# Local (default): *.localhost resolves to 127.0.0.1 in browsers and curl,
# and Caddy issues certificates from its own CA.
MAIL_HOST=mail.localhost
WEBMAIL_HOST=webmail.localhost
AUTODISCOVER_HOST=autodiscover.localhost
TLS_MODE=internal

# Server: real names whose DNS points at this host, Let's Encrypt.
# MAIL_HOST=mail.example.org
# WEBMAIL_HOST=webmail.example.org
# AUTODISCOVER_HOST=autodiscover.example.org
# TLS_MODE=acme
# ACME_EMAIL=postmaster@example.org   # required with acme

# Phones on your LAN against a laptop: use a name that resolves to the
# laptop's LAN address, e.g. via nip.io, keep TLS_MODE=internal and install
# Caddy's root certificate on the phone (see README).
# MAIL_HOST=mail.192-168-1-20.nip.io

# --- Ports on the host -----------------------------------------------------
# HTTP_PORT=80
# HTTPS_PORT=443
# When HTTPS_PORT is not 443, set the suffix the public URLs need, e.g. :8443
# PUBLIC_PORT_SUFFIX=
# SMTP_PORT=25
# SUBMISSIONS_PORT=465
# IMAPS_PORT=993
# EAS_ADMIN_PORT=8081
# STALWART_HTTP_PORT=8082

# --- Images ----------------------------------------------------------------
# The gateway image from GitHub Actions: `latest` follows main, a branch name
# (slashes become dashes) follows that branch, `sha-<commit>` pins a build.
EAS_IMAGE=ghcr.io/business-box/stalwart-activesync:claude-determined-gauss-wql37z
# STALWART_IMAGE=stalwartlabs/stalwart:v0.16.27
# BULWARK_IMAGE=ghcr.io/bulwarkmail/webmail:latest

# --- Behaviour -------------------------------------------------------------
# info,stalwart_activesync=debug logs every decoded EAS request and response.
EAS_LOG=info,stalwart_activesync=debug
# EAS_REQUIRE_PROVISIONING=true
# Set to false to go through Stalwart's setup wizard on 127.0.0.1:8082
# instead of starting with a RocksDB config.
# STALWART_SEED_CONFIG=true
